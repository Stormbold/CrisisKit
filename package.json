{
  "name": "crisiskit",
  "version": "0.1.0",
  "private": true,
  "description": "Build offline emergency pages from simple YAML files",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:example": "node packages/cli/dist/index.js build --input examples/household-de --output examples/household-de/dist"
  },
  "keywords": [
    "emergency",
    "preparedness",
    "offline",
    "yaml",
    "static-site",
    "pdf"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
