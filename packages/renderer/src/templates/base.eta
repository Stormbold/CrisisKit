<!DOCTYPE html>
<html lang="<%= it.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title><%= it.pageTitle %> — <%= it.projectName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <link rel="stylesheet" href="assets/styles/m3-theme.css">
  <link rel="stylesheet" href="assets/styles/main.css">
  <% if (it.extraCss) { %><link rel="stylesheet" href="<%= it.extraCss %>"><% } %>
  <script type="importmap"><%~ it.importMapJson %></script>
  <script type="module" src="assets/scripts/m3-components.js"></script>
</head>
<body>
  <div class="app-shell">
    <header class="top-app-bar">
      <div class="top-app-bar__brand">
        <md-icon aria-hidden="true">shield</md-icon>
        <div>
          <h1 class="top-app-bar__title">CrisisKit</h1>
          <p class="top-app-bar__subtitle"><%= it.projectName %></p>
        </div>
      </div>
      <span class="review-chip">Stand <%= it.lastReviewed %></span>
    </header>

    <div class="nav-scroll" aria-label="Seitennavigation mobil">
      <% it.navItems.forEach(function(item) { %>
      <% if (item.id === it.activePage) { %>
      <md-filled-tonal-button href="<%= item.href %>"><%= item.label %></md-filled-tonal-button>
      <% } else { %>
      <md-outlined-button href="<%= item.href %>"><%= item.label %></md-outlined-button>
      <% } %>
      <% }) %>
    </div>

    <div class="layout">
      <% if (it.showNav !== false) { %>
      <aside class="nav-panel" aria-label="Seitennavigation">
        <md-list>
          <% it.navItems.forEach(function(item) { %>
          <md-list-item
            type="link"
            href="<%= item.href %>"
            <% if (item.id === it.activePage) { %>activated<% } %>>
            <md-icon slot="start"><%= item.icon %></md-icon>
            <div slot="headline"><%= item.label %></div>
          </md-list-item>
          <% }) %>
        </md-list>
      </aside>
      <% } %>

      <main class="content">
        <div class="content-stack">
          <% if (it.disclaimerEnabled) { %>
          <md-outlined-card class="disclaimer-card">
            <div class="card-padding--tight">
              <span class="disclaimer-card__label">Hinweis</span>
              <p class="disclaimer-card__text"><%= it.disclaimerText %></p>
            </div>
          </md-outlined-card>
          <% } %>

          <%~ it.body %>
        </div>
      </main>
    </div>

    <footer class="footer">
      <p>CrisisKit — No panic. Just prepared information.</p>
    </footer>
  </div>
</body>
</html>
